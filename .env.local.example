# Google Calendar — Service Account
# 1. Create a project at https://console.cloud.google.com
# 2. Enable the "Google Calendar API"
# 3. Create a Service Account and download the JSON key
# 4. Each doctor shares their Google Calendar with GOOGLE_SERVICE_ACCOUNT_EMAIL
#    (Settings → Share with specific people → "See all event details")

GOOGLE_SERVICE_ACCOUNT_EMAIL=theracorp@eighth-road-495419-b7.iam.gserviceaccount.com
# Paste the private_key field from the service account JSON (keep the \n literals)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"

# Google Calendar ID for each doctor (found in Calendar Settings → Integrate calendar)
# Format: doctor@gmail.com  or  the "Calendar ID" string shown in Google Calendar settings
GOOGLE_CALENDAR_DOCTOR_MARINA=marina.valente@theracorp.com.br
GOOGLE_CALENDAR_DOCTOR_RAFAEL=rafael.nogueira@theracorp.com.br
GOOGLE_CALENDAR_DOCTOR_HELENA=helena.moraes@theracorp.com.br

# Stripe — Payment Element
# Use test keys while validating the checkout.
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
